# OrcaRouter APIキー（未設定でも scripted モードでデモは動作します）
ORCAROUTER_API_KEY=

# mock | record | live
#   live:   OrcaRouter を呼び、失敗時は golden（録画済み応答）へ自動フォールバック
#   record: live 実行しつつ応答を golden として保存（開発時）
#   mock:   golden のみ使用（外部通信なし）
NW_ROUTE_MODE=live

# auto | scripted | llm（auto: キーがあれば llm、なければ scripted）
NW_AGENT_MODE=auto
